{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(fvm *)",
      "Bash(make *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(supabase migration new *)",
      "Bash(supabase test db *)",
      "Bash(supabase test new *)",
      "Bash(supabase start *)",
      "Bash(supabase stop *)",
      "Bash(supabase status *)",
      "Bash(supabase db diff *)",
      "Bash(supabase gen types *)",
      "Bash(deno test *)",
      "Bash(deno check *)",
      "Bash(deno fmt *)",
      "Bash(scripts/check-no-dash.sh *)",
      "Bash(scripts/check-no-hex.sh *)",
      "Bash(scripts/check-architecture.sh *)",
      "Bash(scripts/check-strings.sh *)",
      "Bash(scripts/check-tasks.sh *)",
      "Bash(scripts/ops/bootstrap-macos.sh *)",
      "Bash(scripts/ops/check-secrets.sh *)",
      "Bash(scripts/ops/supabase-provision.sh *)",
      "Bash(scripts/ops/supabase-query.sh *)",
      "Bash(scripts/ops/observability-provision.sh *)",
      "Bash(scripts/ops/brevo-provision.sh *)",
      "Bash(scripts/ops/revenuecat-provision.sh *)",
      "Bash(scripts/ops/revenuecat-test-event.sh *)",
      "Bash(scripts/ops/revenuecat-customer.sh *)",
      "Bash(scripts/ops/apple-signin-secret.sh *)",
      "Bash(scripts/ops/apple-provision.sh *)",
      "Bash(scripts/ops/android-signing.sh *)",
      "Bash(scripts/ops/play-provision.sh *)",
      "Bash(scripts/ops/tests/*)",
      "Bash(keytool *)",
      "Bash(openssl rand *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(jq *)",
      "WebFetch(domain:docs.flutter.dev)",
      "WebFetch(domain:api.flutter.dev)",
      "WebFetch(domain:dart.dev)",
      "WebFetch(domain:pub.dev)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:www.revenuecat.com)",
      "WebFetch(domain:revenuecat.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:docs.fastlane.tools)",
      "WebFetch(domain:docs.sentry.io)",
      "WebFetch(domain:posthog.com)",
      "WebFetch(domain:developers.brevo.com)"
    ],
    "ask": [
      "Bash(supabase db push *)",
      "Bash(supabase functions deploy *)",
      "Bash(supabase link *)",
      "Bash(supabase secrets *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git rebase *)",
      "Bash(scripts/ops/store-upload.sh *)",
      "Bash(scripts/ops/store-metadata.sh *)",
      "Bash(scripts/ops/store-submit.sh *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(supabase db reset --linked *)",
      "Bash(supabase db reset *)",
      "Bash(supabase projects delete *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(xcrun altool *)",
      "Bash(xcrun notarytool *)",
      "Bash(fastlane *)",
      "Bash(bundle exec fastlane *)",
      "Bash(gradle publish*)",
      "Bash(./gradlew publish*)",
      "Read(./secrets/**)",
      "Read(./secrets/*.env)",
      "Read(./secrets/*.json)",
      "Bash(cat secrets/*)",
      "Bash(source secrets/*)",
      "Read(./env/dev.json)",
      "Read(./env/prod.json)",
      "Read(./env/*.json)",
      "Read(./env/!*.example.json)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/key.properties)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.mobileprovision)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/google-services.json)",
      "Read(~/.ssh/**)",
      "Read(~/.supabase/**)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-forbidden.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-dart.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/analyze-on-stop.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
